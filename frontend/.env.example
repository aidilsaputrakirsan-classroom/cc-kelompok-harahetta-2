

# API Backend URL
VITE_API_URL=http://localhost:8000

# Application Name
VITE_APP_NAME=Harahetta App

# Application Mode (development / production)
VITE_APP_MODE=development

# --- Midtrans Payment Gateway (Sandbox) ---
# Client key AMAN untuk di-expose ke frontend (public key).
# Dapatkan dari https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys.
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
