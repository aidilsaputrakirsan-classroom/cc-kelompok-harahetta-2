# ============================================================
# .env.docker.example — Template untuk Docker Network
# Salin file ini menjadi .env.docker dan sesuaikan valuenya
# JANGAN commit file .env.docker ke Git!
# ============================================================

# Database — hostname pakai nama container 'db' (BUKAN localhost)
# Format: postgresql://USER:PASSWORD@CONTAINER_NAME:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:yourpassword@db:5432/data_sewain

# JWT Authentication
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-minimum-32-characters-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — port 3000 untuk frontend container, 5173 untuk dev lokal
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# App Configuration
APP_PORT=8000
APP_ENV=production

