# ============================================================
# .env.example — Template Environment Variables Sewain
# Salin file ini menjadi .env dan isi dengan value yang sesuai
# JANGAN commit file .env ke Git!
# ============================================================

# --- Database Configuration ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Untuk development lokal:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/data_sewain
# Untuk Docker (ganti localhost dengan host.docker.internal di Mac/Windows):
# DATABASE_URL=postgresql://postgres:yourpassword@host.docker.internal:5432/data_sewain

# --- JWT Authentication ---
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# Minimal 32 karakter, jaga kerahasiaannya!
SECRET_KEY=your-secret-key-minimum-32-characters-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS Configuration ---
# Daftar origin yang diizinkan (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGINS=http://localhost:5173

# --- App Configuration ---
APP_PORT=8000
APP_ENV=development