# ============================================================
# .env.example — Template Environment Variables Sewain
# Salin file ini menjadi .env dan isi dengan value yang sesuai
# JANGAN commit file .env ke Git!
# ============================================================

# --- Environment ---
# development = mode lokal, production = mode Railway
# Di Railway, set ini ke "production"
ENVIRONMENT=development

# --- Database Configuration ---
# Development (SQLite lokal):
DATABASE_URL=sqlite:///./sewain.db
# Production (PostgreSQL Railway) — isi di Railway Variables:
# DATABASE_URL=postgresql://postgres:PASSWORD@containers-xxx.railway.internal:5432/railway

# --- JWT Authentication ---
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# Minimal 32 karakter, jaga kerahasiaannya!
SECRET_KEY=your-secret-key-minimum-32-characters-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS Configuration ---
# Development: URL Vite dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (Railway): ganti dengan URL frontend Railway
# CORS_ORIGINS=https://cloudapp-frontend-xxx.up.railway.app

# --- Midtrans Payment Gateway (Sandbox) ---
# Dapatkan dari https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
# false = sandbox, true = production
MIDTRANS_IS_PRODUCTION=false

# --- Email Service ---
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@sewain.app
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587